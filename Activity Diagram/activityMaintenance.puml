@startuml activityMaintenance

title Activity Diagram Maintenance

|Admin|
start
:Membuka Aplikasi;

repeat

    |Sistem|
    :Tampilkan Halaman Login;

    |Admin|
    :Input Username & Password;

    |Sistem|
    :Validasi Akun;

repeat while (Login Gagal?) is (Ya)

|Admin|
:Pilih Menu Maintenance;

|Sistem|
:Tampilkan Daftar & Form Maintenance;

|Admin|
if (Input Data Maintenance Baru?) then (Ya)

    repeat

        :Isi Detail Perbaikan/Maintenance;
        :Klik Tombol Simpan;

        |Sistem|
        :Validasi Input Data;

        if (Input Valid?) then (Ya)
            :Simpan data permintaan ke satprasDB;
            :Tampilkan notifikasi sukses;
        else (Tidak)
            :Aktifkan fail-safe mode;
            :Tampilkan pesan error;
        endif

        |Admin|

    repeat while (Tambah Data Lagi?) is (Ya)

    -> Tidak;

else (Hanya Lihat Data)

endif

|Admin|
:Kembali ke Halaman Utama;

stop
@enduml